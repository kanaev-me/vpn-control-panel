[Unit]
Description=VPN Panel
After=network.target ipsec.service xl2tpd.service
Wants=ipsec.service xl2tpd.service

[Service]
Type=simple
WorkingDirectory=/opt/vpn-panel
EnvironmentFile=/opt/vpn-panel/panel.env
ExecStart=/usr/bin/python3 /opt/vpn-panel/app.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
