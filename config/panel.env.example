# Generic, secret-free runtime configuration.
# Copy this file for a tenant and set tenant-specific values explicitly.
# Never commit panel.env, passwords, databases, profiles, certificates or keys.

VPN_APP_NAME=VPN
VPN_BRAND_NAME=VPN
VPN_PUBLIC_DOMAIN=vpn.example.invalid
VPN_SERVICE_PREFIX=vpn

VPN_PANEL_HOST=127.0.0.1
VPN_PANEL_PORT=8711
VPN_PANEL_APP_DIR=/opt/vpn-panel
VPN_PANEL_DB_PATH=/opt/vpn-panel/panel.db
VPN_PANEL_ACTION_LOG=/opt/vpn-panel/actions.log
VPN_PANEL_STATUS_DIR=/var/lib/vpn-panel/status
VPN_PANEL_INSTRUCTIONS_DIR=/var/lib/vpn-panel/instructions
VPN_PANEL_CACHE_DIR=/var/cache/vpn-panel

# Optional. Leave empty until you know the real usable VPN uplink capacity.
# Example: VPN_CHANNEL_CAPACITY_MBIT=500
VPN_CHANNEL_CAPACITY_MBIT=

# The bundled hwdsl2 script creates client profiles in /root on each VPN host.
VPN_IKEV2_SCRIPT=/opt/src/ikev2.sh
VPN_CERT_DB=sql:/etc/ipsec.d

VPN_PANEL_SERVICE=vpn-panel
VPN_CADDY_SERVICE=caddy
VPN_IPSEC_SERVICE=ipsec
VPN_L2TP_SERVICE=xl2tpd
VPN_DEFAULT_ACCESS_GROUP=default

VPN_PULSE_ENDPOINT_ENABLED=0
VPN_PULSE_SYNC_ENABLED=0
VPN_PULSE_CONTRACT=vpn-pulse-v1
VPN_PULSE_NAME=VPN
VPN_PULSE_SLUG=vpn
